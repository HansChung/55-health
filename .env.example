# ────────────────────────────────────────────────
# 暖暖 55+ 環境變數設定範本
# 1. 複製這個檔案改名成 .env.local
# 2. 填入你的 API keys
# ────────────────────────────────────────────────

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Gemini 直連（沒設 LK888_API_KEY 或 GEMINI_PROVIDER=google 時才用）
# 一定要用 flash，gemini-2.5-pro 免費額度=0（程式有保險絲會自動改回 flash）
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI（即時語音對話）
# 模型名稱是 gpt-realtime（沒有 -2！填錯語音會壞）
OPENAI_API_KEY=your-openai-key-here
OPENAI_REALTIME_MODEL=gpt-realtime

# 邁笙 AI 影音創作平台（https://maxim.lk888.ai/apidoc）
# 有設 key 就會：① 出遊回憶影片（minimax-h3）② 拍照辨識食物／藥袋（gem-3.8-flash）
# ③ AI 建議（gem-3.5-flash-lite）全部走這裡，不再需要 GEMINI_API_KEY
# 影片需先跑 supabase/add-travel-videos.sql
LK888_API_KEY=sk-your-lk888-key-here
# 選填：LK888_VIDEO_MODEL=minimax-h3、LK888_VISION_MODEL=gem-3.8-flash、
#       LK888_TEXT_MODEL=gem-3.5-flash-lite、LK888_API_BASE=https://api.lk888.ai
# Gemini（拍照辨識＋AI 建議）想改回 Google 直連：GEMINI_PROVIDER=google
# 影片做好推播：平台完成回呼的路徑密鑰（至少 16 字，隨機產生：openssl rand -hex 16）；
# 需搭配 NEXT_PUBLIC_APP_URL 為正式 https 網域 + 下方 Web Push VAPID 金鑰
# LK888_WEBHOOK_SECRET=

# App（正式環境填 nuan55.com；本地開發用 localhost）
NEXT_PUBLIC_APP_URL=https://nuan55.com

# Admin（管理員 email，可多個用逗號分隔；自動 bypass AI 配額）
ADMIN_EMAILS=your@email.com

# Stripe（訂閱付費，未啟用時可留空）
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_BASIC=
# STRIPE_PRICE_PRO=

# Upstash Redis（全站 API rate limit；正式站建議設定）
# 到 https://console.upstash.com 建 Redis → REST API → 複製兩項
# 未設定時本機用記憶體後備（單一行程有效；Vercel 多實例不共享）
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxxxx
# 測試時可關閉：RATE_LIMIT_DISABLED=1

# Web Push（異常預警即時推播）
# 產生金鑰：npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=BPxxxx
# VAPID_PRIVATE_KEY=xxxxx
# VAPID_SUBJECT=mailto:noreply@nuan55.com


